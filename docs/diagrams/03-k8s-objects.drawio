    <mxCell id="title" value="&lt;b&gt;Task Board on Kubernetes — every object in k8s/ and how they connect&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8px'&gt;solid = request path · dashed green = referenced config/credentials · numbers = manifest file&lt;/span&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="700" height="40" as="geometry"/>
