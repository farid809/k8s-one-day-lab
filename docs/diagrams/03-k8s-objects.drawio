    <mxCell id="svc-gw" value="&lt;b&gt;Service: gateway (09)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8px'&gt;type: NodePort — the only door to the outside&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;arcSize=10;" vertex="1" parent="g-ns">
