    <mxCell id="svc-db" value="&lt;b&gt;Service: db (04)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8px'&gt;ClusterIP — stable name for whatever postgres pod exists&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;arcSize=10;" vertex="1" parent="g-ns">
