<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="500" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="&lt;b&gt;Task Board — application architecture&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8px'&gt;the same three tiers in both exercises; only the platform underneath changes&lt;/span&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="520" height="40" as="geometry"/>
    </mxCell>

    <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8px'&gt;static UI + fetch /api/*&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#07125E;fontSize=9;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="160" width="150" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="gateway" value="&lt;b&gt;gateway&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8px'&gt;nginx:1.27-alpine&lt;br&gt;serves / (static UI)&lt;br&gt;proxies /api/* → api:8000&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#07125E;fontSize=9;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="270" y="150" width="190" height="80" as="geometry"/>
    </mxCell>

    <mxCell id="api" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8px'&gt;FastAPI, ~100 lines&lt;br&gt;CRUD on tasks table&lt;br&gt;config via env vars&lt;br&gt;/healthz + /readyz&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#07125E;fontSize=9;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="540" y="145" width="190" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="db" value="&lt;b&gt;db&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8px'&gt;postgres:16-alpine&lt;br&gt;seeded by init.sql on first boot&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FAFAFA;strokeColor=#07125E;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="810" y="135" width="170" height="110" as="geometry"/>
    </mxCell>

    <mxCell id="volume" value="&lt;b&gt;data volume&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8px'&gt;/var/lib/postgresql/data&lt;br&gt;Ex1: docker volume · Ex2: PVC&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="810" y="320" width="170" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="e-browser-gw" value=":80 / :8080" style="strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#333;" edge="1" parent="1" source="browser" target="gateway">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-gw-api" value="http://api:8000" style="strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#333;" edge="1" parent="1" source="gateway" target="api">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-api-db" value="db:5432" style="strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#333;" edge="1" parent="1" source="api" target="db">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-db-vol" style="strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="db" target="volume">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="note-names" value="&lt;b&gt;Names, not IPs&lt;/b&gt;&#10;The gateway calls &quot;api&quot;; the API calls &quot;db&quot;. Exercise 1: Docker network DNS resolves container names. Exercise 2: cluster DNS resolves Service names. Same config, both worlds." style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#546E7A;rounded=1;whiteSpace=wrap;fontColor=#232F3E;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
      <mxGeometry x="270" y="320" width="320" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&#10;⬜ component (a container)&#10;🟩 persistent state — survives containers" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#546E7A;rounded=1;whiteSpace=wrap;fontColor=#232F3E;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
      <mxGeometry x="40" y="320" width="190" height="70" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
